{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Drift",
  "scopeName": "source.drift",
  "patterns": [
    { "include": "#excMarkers" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#brackets" },
    { "include": "#functions" }
  ],
  "repository": {
    "excMarkers": {
      "patterns": [
        {
          "name": "invalid.illegal.drift",
          "match": "@(?=exc\\b)|\\.exc\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.drift",
          "match": "//.*$",
          "captures": {
            "0": { "name": "comment.line.drift" }
          }
        },
        {
          "name": "comment.block.drift",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "meta.embedded.block.drift",
              "begin": "^\\s*@exc\\s*$",
              "end": "^\\s*\\.exc\\s*$",
              "beginCaptures": {
                "0": { "name": "invalid.illegal.drift" }
              },
              "endCaptures": {
                "0": { "name": "invalid.illegal.drift" }
              },
              "patterns": [
                { "include": "#excMarkers" },
                { "include": "#strings" },
                { "include": "#chars" },
                { "include": "#numbers" },
                { "include": "#keywords" },
                { "include": "#constants" },
                { "include": "#operators" },
                { "include": "#brackets" },
                { "include": "#functions" },
                { "include": "#identifiers" }
              ]
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.drift",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.drift",
          "match": "\\\\[nrt\\\\\"']"
        },
        {
          "name": "source.drift.interpolation",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.drift" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.drift" }
          },
          "patterns": [
            { "include": "#interpolation-body" }
          ]
        }
      ]
    },
    "interpolation-body": {
      "patterns": [
        { "include": "#identifiers" },
        { "include": "#operators" },
        { "include": "#numbers" }
      ]
    },
    "chars": {
      "name": "constant.character.drift",
      "match": "'([^\\\\]|\\\\.)'",
      "captures": {
        "0": { "name": "constant.character.drift" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.drift",
          "match": "(?<!\\.)\\b\\d+\\.\\d+(?!\\.)"
        },
        {
          "name": "constant.numeric.integer.drift",
          "match": "(?<!\\.)\\b\\d+(?!\\.)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.drift",
          "match": "\\b(say|ask|var|if|elif|else|repeat|for|while|end)\\b"
        },
        {
          "name": "keyword.operator.logical.drift",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.drift",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.drift",
          "match": "\\b(NULL|INF)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.drift",
          "match": "\\b(say|ask|int|float|string|char)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.drift",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.drift", "match": "(<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=)" },
        { "name": "keyword.operator.increment.drift", "match": "(\\+\\+|--)" },
        { "name": "keyword.operator.range.drift", "match": "\\.\\.\\." },
        { "name": "keyword.operator.relational.drift", "match": "(==|!=|>=|<=|>|<)" },
        { "name": "keyword.operator.logical.drift", "match": "(&&|\\|\\||!)" },
        { "name": "keyword.operator.bitwise.drift", "match": "(<<|>>|&|\\||\\^|~)" },
        { "name": "keyword.operator.arithmetic.drift", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.access.drift", "match": "[\\[\\]\\.()]" }
      ]
    },
    "brackets": {
      "patterns": [
        { "name": "meta.brace.round.drift", "match": "[()]" },
        { "name": "meta.brace.square.drift", "match": "[\\[\\]]" },
        { "name": "meta.brace.curly.drift", "match": "[{}]" }
      ]
    },
    "identifiers": {
      "name": "variable.other.drift",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
