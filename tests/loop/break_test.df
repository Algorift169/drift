var while_index = 0
while while_index < 5:
    while_index++
    if while_index == 3:
        break
    end
    say while_index
end

for var for_index = 0, for_index < 5, for_index++:
    if for_index == 2:
        break
    end
    say for_index
end

repeat var repeat_index (0...4):
    if repeat_index == 2:
        break
    end
    say repeat_index
end